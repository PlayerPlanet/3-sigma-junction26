# ==============================================================
# Training Job Dockerfile
# ==============================================================
# One-shot container that trains a model and logs it to MLflow.
# In production, you'd trigger this via a CI/CD pipeline or
# a job scheduler (Airflow, Kubernetes Jobs, etc.)
# ==============================================================

FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY config/ ./config/

ENV MLFLOW_TRACKING_URI=http://mlflow-server:5000 \
    MLFLOW_EXPERIMENT_NAME=3-sigma-junction26

# Default: train with config defaults, override via CLI args
CMD ["python", "src/train.py"]
