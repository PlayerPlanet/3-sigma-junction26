{
  "name": "lab-rats",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @lab-rats/server\" \"npm run dev -w @lab-rats/web\"",
    "build": "npm run build -w @lab-rats/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts --noEmit",
    "seed-db": "tsx scripts/seed-db.ts",
    "replay": "tsx scripts/replay.ts",
    "headless": "tsx scripts/headless-run.ts",
    "play": "tsx scripts/play.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
