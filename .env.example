# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=3-sigma-junction26
MLFLOW_MODEL_NAME=inference-model

# Model Serving Configuration
MODEL_STAGE=Production
SERVE_PORT=8787

# Storage (local paths for dev, S3 for production)
MLFLOW_ARTIFACT_ROOT=./mlflow_artifacts

# Lab Rats game server (apps/server reads the repo-root .env)
# The LLM robot controller is optional: without a key + model, robots set to "llm" get the mock controller (it only wanders).
# LLM_MODEL is the provider's model id, e.g. a Gemini model id, or claude-opus-5-5 for anthropic.
# LLM_PROVIDER: gemini | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Relative paths resolve against the repo root.
DB_PATH=data/labrats.sqlite
# CONTENT_DIR=content
# PORT=8790
